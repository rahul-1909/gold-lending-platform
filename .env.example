# ======================================================================
# StarFinance Gold Loan Management System - Environment Variables Example
# Copy this file to .env and adjust credentials as needed.
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ======================================================================

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/star_finance_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Server & CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Security & JWT (Must be at least 256-bit secret for HMAC-SHA256)
JWT_SECRET=starfinance-production-grade-256-bit-secure-jwt-signing-key-for-gold-loan-system
JWT_EXPIRATION=3600000

# Optional OAuth2 Credentials (Google / Facebook)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
